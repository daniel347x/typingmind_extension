[Unit]
Description=LLM Relay - transport-only content-addressed dedup proxy
Documentation=file:/opt/llm-relay/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/llm-relay
EnvironmentFile=-/etc/llm-relay/env
ExecStart=/usr/bin/python3 -m relay --config /opt/llm-relay/config/relay.json
Restart=on-failure
RestartSec=3

# --- hardening (the relay holds no provider keys, but be strict anyway) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/llm-relay
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# --- logging ---
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llm-relay

[Install]
WantedBy=multi-user.target
